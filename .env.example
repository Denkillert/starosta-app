# Скопируйте в .env и заполните.

# --- База данных ---------------------------------------------------------
# Локально без MySQL — SQLite (по умолчанию):
DATABASE_URL=sqlite:///./data/starosta.db
# MySQL 8 (необязательно, запускается вручную):
# DATABASE_URL=mysql+pymysql://starosta:starosta@127.0.0.1:3306/starosta?charset=utf8mb4

# --- Telegram ------------------------------------------------------------
# Токен от @BotFather. Если пуст — бот не запускается, веб и API работают.
BOT_TOKEN=
BOT_USERNAME=
WEB_BASE_URL=http://localhost:8000

# Секрет для подписи cookie-сессии. Если пуст, используется BOT_TOKEN.
# Задайте отдельное длинное значение в продакшене.
SESSION_SECRET=

# --- Режим разработки ----------------------------------------------------
# true: гостевой вход по X-Telegram-Id или DEV_TELEGRAM_ID — только при
#       прямом подключении из локальной сети. Через туннель всё равно нужен
#       подписанный Telegram initData.
# false: только подписанный Telegram initData (для продакшена за HTTPS).
DEV_MODE=true
# true: разрешить гостевой вход и через туннель (небезопасно — ссылку сможет
#       открыть любой и получить права старосты). Оставьте false, если не нужно.
DEV_MODE_PUBLIC=false
DEV_TELEGRAM_ID=100000001
DEV_USER_NAME=Староста

# --- Файлы и время -------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
TIMEZONE=Europe/Minsk

# --- Сеть (доступ с телефона) --------------------------------------------
# 0.0.0.0 — открывает порт в локальной сети; 127.0.0.1 — только этот ПК.
HOST=0.0.0.0
PORT=8000

# --- Учёт ----------------------------------------------------------------
# Учебных часов в одной паре и стоимость платной отработки за пару.
ACADEMIC_HOURS_PER_LESSON=2
PAID_LESSON_RATE=18.47

# Порог устаревания: через сколько часов расписание считается старым.
SCHEDULE_SYNC_HOURS=6

# --- Фоновая синхронизация расписания ------------------------------------
# Работает внутри веб-процесса (uvicorn). Бот её не запускает.
SCHEDULER_ENABLED=true
# Пауза перед первым проходом после старта сервера, секунд.
SCHEDULER_STARTUP_DELAY_SECONDS=60
# 0 — проверять каждые SCHEDULE_SYNC_HOURS * 60 минут.
SCHEDULER_INTERVAL_MINUTES=0
# Пауза между запросами к polessu.by (robots.txt: Crawl-delay 10).
POLESSU_CRAWL_DELAY_SECONDS=10
